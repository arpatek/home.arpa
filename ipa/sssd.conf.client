[domain/home.arpa]

id_provider = ipa
ipa_server = _srv_, prod-ipa-0.home.arpa
ipa_domain = home.arpa
ipa_hostname = prod-mon-0.home.arpa
auth_provider = ipa
chpass_provider = ipa
access_provider = ipa
cache_credentials = True
ldap_tls_cacert = /etc/ipa/ca.crt
krb5_store_password_if_offline = True
[sssd]
services = nss, pam, ssh, sudo

domains = home.arpa
[nss]
homedir_substring = /home

[pam]

[sudo]

[autofs]

[ssh]

[pac]

[ifp]

[session_recording]

