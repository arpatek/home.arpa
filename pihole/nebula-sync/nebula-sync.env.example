# /etc/nebula-sync/nebula-sync.env
# Config for nebula-sync (https://github.com/lovelaze/nebula-sync).
# Copy to /etc/nebula-sync/nebula-sync.env, fill in the app passwords, then:
#   sudo chown root:nebula-sync /etc/nebula-sync/nebula-sync.env
#   sudo chmod 0640 /etc/nebula-sync/nebula-sync.env
#
# App passwords are generated per instance in the Pi-hole web UI:
#   Settings > (Expert mode) > Web interface / API > Configure app password.
# Use app passwords, NOT the admin password — scoped and revocable.
# The replica (edgerunner) also needs webserver.api.app_sudo = true for the
# teleporter import to be permitted (see docs/gotchas.md).

# ── Targets ── host|app_password
PRIMARY=http://10.33.111.141|REPLACE_NETRUNNER_APP_PW
REPLICAS=http://10.33.111.142|REPLACE_EDGERUNNER_APP_PW

# ── Sync mode ──
# Selective, not full — FULL_SYNC would teleport the DHCP block and flip
# dhcp.active on the replica, producing two DHCP servers on the /24.
FULL_SYNC=false

# ── Config sections ── (all default false; enable only the safe ones)
SYNC_CONFIG_DNS=true
SYNC_CONFIG_RESOLVER=true
SYNC_CONFIG_NTP=true
SYNC_CONFIG_MISC=true
SYNC_CONFIG_DHCP=false        # the guard — never replicate DHCP
SYNC_CONFIG_DATABASE=false    # each instance keeps its own query stats

# ── Gravity (blocklists / groups / clients) ──
SYNC_GRAVITY_GROUP=true
SYNC_GRAVITY_AD_LIST=true
SYNC_GRAVITY_AD_LIST_BY_GROUP=true
SYNC_GRAVITY_DOMAIN_LIST=true
SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP=true
SYNC_GRAVITY_CLIENT=true
SYNC_GRAVITY_CLIENT_BY_GROUP=true
SYNC_GRAVITY_DHCP_LEASES=false

# ── Behavior ──
RUN_GRAVITY=true              # rebuild the replica's blocklist after sync
TZ=America/Los_Angeles
# CRON left unset — scheduling is handled by nebula-sync.timer, run once per invocation.
